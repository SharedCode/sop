# Slim runtime image for the SOP quickstart demo.
# Built and published by .github/workflows/deliver.yml (GHCR).
FROM golang:1.26.8-alpine AS build
WORKDIR /src
# Download modules before copying source so this layer is cached across
# source-only changes and only re-runs when go.mod/go.sum change.
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/quickstart ./examples/quickstart

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/quickstart /quickstart
ENTRYPOINT ["/quickstart"]
